# Postgres with the pgvector extension (npm run db:up starts one in Docker)
DATABASE_URL=postgres://rso:rso@localhost:5432/rso

# AI switch. Off by default: no API calls, even with keys below. The app still works
# end to end with offline embeddings and answers quoted straight from the sources.
# Turn on to use Claude/OpenAI (with keys), or free local models through Ollama (no key).
USE_AI=false

# Free local AI, no API key: install https://ollama.com, then
#   ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# Used when USE_AI=true and the keys below are empty. Re-ingest after setting the embedding model.
LOCAL_MODEL=
LOCAL_EMBEDDING_MODEL=
OLLAMA_URL=http://localhost:11434

# Embeddings (OpenAI text-embedding-3-small, 1536 dimensions). Re-ingest after setting.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Answer generation and the eval's LLM judge (Anthropic)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

PORT=3000
