{
  "name": "rso-funding-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Answers FSU student organizations' funding questions from the SGA Financial Manual, with citations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx src/cli/migrate.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "ask": "tsx src/cli/ask.ts",
    "eval": "tsx src/cli/eval.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "eval:offline": "tsx src/cli/eval.ts --generator extractive"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "web"
  ]
}
