{
  "name": "rso-funding-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Answers FSU student organizations' funding questions from the SGA Financial Manual, with citations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx src/cli/migrate.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "ask": "tsx src/cli/ask.ts",
    "eval": "tsx src/cli/eval.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "eval:offline": "tsx src/cli/eval.ts --generator extractive",
    "start:prod": "sh scripts/start.sh",
    "demo": "tsx src/cli/demo.ts",
    "build:static": "npm run build:static -w web",
    "crawl": "tsx src/cli/crawl.ts",
    "ingest:corpus": "tsx src/cli/ingest-corpus.ts",
    "corpus:pull": "tsx src/cli/corpus-pull.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "web"
  ]
}
